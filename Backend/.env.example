DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# Postgres / PostGIS. Leave DB_NAME empty to use the local sqlite file.
# Docker Compose overrides DB_SSLROOTCERT with /app/global-bundle.pem.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLROOTCERT=

# S3 media. Leave the bucket empty to store uploads on local disk.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Auth0 API (JWT validation — no client secret)
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
